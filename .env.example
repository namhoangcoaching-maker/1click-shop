# File MẪU – copy thành .env.local rồi điền giá trị thật.
# .env.local đã nằm trong .gitignore, không bị đưa lên GitHub.
# KHÔNG điền giá trị thật vào file này.

# --- Supabase (Bước 0.4) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Dòng kết nối database (Connect → Direct → Session pooler), chỉ dùng cho lệnh npm run db:...
SUPABASE_DB_URL=

# --- Mã hóa token của khách (Bước 0.6) ---
ENCRYPTION_KEY=

# --- Mật khẩu cho lịch tự động gọi /api/cron (Giai đoạn 1) ---
CRON_SECRET=

# --- Dùng ở các giai đoạn sau ---
ANTHROPIC_API_KEY=
HIGGSFIELD_API_KEY=
TELEGRAM_BOT_TOKEN=
